{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "autoCloseBefore": ":,=}]\"' \n\t",
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*(?:#?region)\\b",
      "end": "^\\s*#\\s*(?:#?endregion)\\b"
    }
  },
  "wordPattern": "(#?[a-z0-9_.-]+:[a-z0-9_./-]+)|(@[a-z](?:\\[[^\\]]*\\])?)|([^\\s\\[\\]{}(),=]+)"
}
