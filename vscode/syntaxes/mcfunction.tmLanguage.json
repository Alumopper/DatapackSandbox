{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Minecraft Function",
  "scopeName": "source.mcfunction",
  "patterns": [
    { "include": "#comments" },
    { "include": "#command-root" },
    { "include": "#strings" },
    { "include": "#macros" },
    { "include": "#selectors" },
    { "include": "#resources" },
    { "include": "#coordinates" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#punctuation" },
    { "include": "#arguments" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.mcfunction",
          "match": "^\\s*#.*$"
        }
      ]
    },
    "command-root": {
      "patterns": [
        {
          "match": "^(\\s*)(\\$)?(\\/)?([a-z_][a-z0-9_]*)",
          "captures": {
            "2": { "name": "keyword.other.macro.mcfunction" },
            "3": { "name": "invalid.deprecated.leading-slash.mcfunction" },
            "4": { "name": "keyword.control.command.mcfunction" }
          }
        },
        {
          "match": "\\b(run)(\\s+)([a-z_][a-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.execute.mcfunction" },
            "3": { "name": "keyword.control.command.mcfunction" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.mcfunction",
          "begin": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.mcfunction" } },
          "end": "\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.mcfunction" } },
          "patterns": [
            { "name": "constant.character.escape.mcfunction", "match": "\\\\." },
            { "include": "#macros" }
          ]
        },
        {
          "name": "string.quoted.single.mcfunction",
          "begin": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.mcfunction" } },
          "end": "'",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.mcfunction" } },
          "patterns": [
            { "name": "constant.character.escape.mcfunction", "match": "\\\\." },
            { "include": "#macros" }
          ]
        }
      ]
    },
    "macros": {
      "patterns": [
        {
          "name": "meta.template.expression.mcfunction",
          "match": "(\\$\\()([A-Za-z0-9_.-]+)(\\))",
          "captures": {
            "1": { "name": "punctuation.definition.template-expression.begin.mcfunction" },
            "2": { "name": "variable.other.macro.mcfunction" },
            "3": { "name": "punctuation.definition.template-expression.end.mcfunction" }
          }
        }
      ]
    },
    "selectors": {
      "patterns": [
        {
          "name": "meta.selector.mcfunction",
          "begin": "(@[a-z])(?=\\[)",
          "beginCaptures": { "1": { "name": "variable.language.selector.mcfunction" } },
          "end": "\\]",
          "endCaptures": { "0": { "name": "punctuation.section.brackets.end.mcfunction" } },
          "patterns": [
            { "name": "variable.language.selector.mcfunction", "match": "@[a-z]" },
            { "name": "variable.parameter.selector.mcfunction", "match": "[a-z_][a-z0-9_]*(?=\\s*=)" },
            { "include": "#strings" },
            { "include": "#resources" },
            { "include": "#numbers" },
            { "include": "#constants" },
            { "include": "#punctuation" }
          ]
        },
        { "name": "variable.language.selector.mcfunction", "match": "@[a-z]" }
      ]
    },
    "resources": {
      "patterns": [
        {
          "name": "entity.name.function.resource-location.mcfunction",
          "match": "#?[a-z0-9_.-]+:[a-z0-9_./-]+"
        },
        {
          "name": "entity.name.function.resource-path.mcfunction",
          "match": "#?[a-z0-9_.-]+/[a-z0-9_./-]+"
        }
      ]
    },
    "coordinates": {
      "patterns": [
        { "name": "constant.numeric.coordinate.mcfunction", "match": "(?<![A-Za-z0-9_.])(?:[~^](?:[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+))?|[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+))(?=\\s|$)" },
        { "name": "keyword.operator.range.mcfunction", "match": "\\.\\." }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.mcfunction", "match": "(?<![A-Za-z0-9_])[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?[bBsSlLfFdD]?(?![A-Za-z0-9_])" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.mcfunction", "match": "\\b(?:true|false)\\b" },
        { "name": "constant.language.gamemode.mcfunction", "match": "\\b(?:survival|creative|adventure|spectator)\\b" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "constant.character.escape.line-continuation.mcfunction", "match": "\\\\\\s*$" },
        { "name": "punctuation.section.braces.mcfunction", "match": "[{}]" },
        { "name": "punctuation.section.brackets.mcfunction", "match": "[\\[\\]]" },
        { "name": "punctuation.section.parens.mcfunction", "match": "[()]" },
        { "name": "keyword.operator.assignment.mcfunction", "match": "(?:!=|<=|>=|=|<|>)" },
        { "name": "punctuation.separator.mcfunction", "match": "[:,;]" }
      ]
    },
    "arguments": {
      "patterns": [
        { "name": "variable.other.argument.mcfunction", "match": "\\b[a-z_][a-z0-9_.-]*\\b" }
      ]
    }
  }
}
